# Goal
geometry_msgs/Point[] points
MotorSpeeds[] speeds  # jedna MotorSpeeds (pole rychlosti na motor) na kazdy bod
bool is_ball_action  # true = ball (predpocita vse, rychle), false = precision (po kazdem bodu ustaleni)
int32 settle_point_index  # precision: index bodu s delsim ustalenim; -1 = zadny
---
# Result
bool success
string message
---
#Feedback
uint32 current_point
float32 distance_remaining
